#!/bin/bash
PIDFILE=/Users/wow/code/ClickHouse/tmp/clickbench-server/clickbench.pid
if [ -f "$PIDFILE" ]; then
    pid=$(cat "$PIDFILE")
    kill "$pid" 2>/dev/null
    for i in $(seq 1 120); do
        kill -0 "$pid" 2>/dev/null || break
        sleep 1
    done
    kill -9 "$pid" 2>/dev/null
    rm -f "$PIDFILE"
fi
exit 0
